---
interface Props {
  class?: string;
}

const { class: className = "h-9 w-9" } = Astro.props;
const uid = `luz-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id={`${uid}-bg`} cx="50%" cy="44%" r="62%">
      <stop offset="0%" stop-color="#14293a" />
      <stop offset="55%" stop-color="#091423" />
      <stop offset="100%" stop-color="#030711" />
    </radialGradient>
    <linearGradient id={`${uid}-border`} x1="4" y1="32" x2="60" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#34d399" stop-opacity="0.92" />
      <stop offset="48%" stop-color="#6ee7b7" stop-opacity="0.7" />
      <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.9" />
    </linearGradient>
    <linearGradient id={`${uid}-arc`} x1="12" y1="16" x2="52" y2="48" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#6ee7b7" />
      <stop offset="50%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" stop-opacity="0.65" />
    </linearGradient>
    <linearGradient id={`${uid}-bolt`} x1="26" y1="10" x2="36" y2="54" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#fef9c3" />
      <stop offset="28%" stop-color="#fde047" />
      <stop offset="65%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <linearGradient id={`${uid}-edge`} x1="22" y1="10" x2="40" y2="55" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="55%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#b45309" />
    </linearGradient>
    <linearGradient id={`${uid}-shine`} x1="28" y1="11" x2="25" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.78" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0" />
    </linearGradient>
    <linearGradient id={`${uid}-wave-amber`} x1="30" y1="40" x2="54" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="45%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#fde047" stop-opacity="0.2" />
    </linearGradient>
    <linearGradient id={`${uid}-wave-green`} x1="10" y1="40" x2="38" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#34d399" stop-opacity="0.2" />
      <stop offset="40%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
  </defs>

  <rect width="64" height="64" rx="14.5" fill={`url(#${uid}-bg)`} />
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="13.75" stroke={`url(#${uid}-border)`} stroke-width="1.5" />

  <path d="M27.5 12.2A20.2 20.2 0 0 0 22.8 50.2" stroke={`url(#${uid}-arc)`} stroke-width="2.2" stroke-linecap="round" />
  <path d="M39.5 13.4A20.2 20.2 0 0 1 32.5 52.2" stroke={`url(#${uid}-arc)`} stroke-width="1.8" stroke-linecap="round" />
  <path d="M26.5 15.2A17.2 17.2 0 0 0 23.5 47.2" stroke="#10b981" stroke-opacity="0.38" stroke-width="1.1" stroke-linecap="round" />
  <path d="M38.2 16.2A17.2 17.2 0 0 1 33.2 49.2" stroke="#10b981" stroke-opacity="0.38" stroke-width="1.1" stroke-linecap="round" />

  <path d="M9.5 40.8H16.5L18.8 38.2L21.2 44.5L23.8 34.5L26.2 42.5L28.5 39.5" stroke={`url(#${uid}-wave-green)`} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M31.5 44.8L34.2 38.5L36.8 42.2L39.8 34.2L42.5 44.5L45.2 38.2L47.5 40.8H54.5" stroke={`url(#${uid}-wave-amber)`} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />

  <path d="M30.8 10.2H39.8L33.4 27.2H43.6L25.4 55.2L30.4 33.8H21.8L30.8 10.2Z" fill={`url(#${uid}-bolt)`} stroke={`url(#${uid}-edge)`} stroke-width="1.3" stroke-linejoin="round" />
  <path d="M31.6 11.8H37.8L31.8 27.6H27.2L23.8 32.2H31.8L27.5 50.2L41.2 28.8H32.2L31.6 11.8Z" fill="#d97706" fill-opacity="0.24" />
  <path d="M31.5 11.5H36.8L29.8 28.5L24.2 31.8L31.5 11.5Z" fill={`url(#${uid}-shine)`} />
</svg>
