---
import { Zap, SunMedium, Clock, Info } from "@lucide/astro";
import { withBase } from "../lib/site";
---

<header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo e Identidad -->
      <a href={withBase()} class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-amber-400 rounded-xl p-1">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 font-black shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform">
          <Zap size={24} class="fill-current" />
        </div>
        <div>
          <span class="text-lg sm:text-xl font-extrabold tracking-tight flex items-center gap-1.5">
            <span>LUZ</span>
            <span class="text-emerald-400">EXTREMADURA</span>
          </span>
          <span class="block text-[10px] sm:text-xs font-semibold text-slate-400 tracking-wider uppercase">
            Precio PVPC hoy · Badajoz y Cáceres
          </span>
        </div>
      </a>

      <!-- Navegación y Enlaces rápidos -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-300">
        <a href="#horas-hoy" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
          <Clock size={16} />
          <span>Horas de hoy</span>
        </a>
        <a href="#calculadora" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
          <Zap size={16} />
          <span>Calculadora</span>
        </a>
        <a href="#extremadura-energia" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
          <SunMedium size={16} />
          <span>Extremadura Solar</span>
        </a>
        <a href="#faqs" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
          <Info size={16} />
          <span>Dudas frecuentes</span>
        </a>
      </nav>

      <!-- Badge de actualización en vivo -->
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-950/80 text-emerald-300 border border-emerald-700/60">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>PVPC Oficial REE</span>
        </span>
      </div>
    </div>
  </div>
</header>
