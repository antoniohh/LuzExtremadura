---
import { Zap, Heart, Shield, RefreshCw } from "@lucide/astro";
import { withBase, AUTHOR_NAME, AUTHOR_URL } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-xs sm:text-sm mt-16 sm:mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pb-10 border-b border-slate-800/80">
      <!-- Columna 1: Info e Identidad -->
      <div>
        <div class="flex items-center gap-2.5 text-white font-extrabold text-base mb-3">
          <div class="w-7 h-7 rounded-lg bg-amber-400 text-slate-950 flex items-center justify-center">
            <Zap size={16} class="fill-current" />
          </div>
          <span>LUZ <span class="text-emerald-400">EXTREMADURA</span></span>
        </div>
        <p class="leading-relaxed text-slate-400 text-xs sm:text-sm">
          Herramienta digital ciudadana para la consulta limpia, rápida y sin publicidad del precio del kilovatio hora (PVPC tarifa 2.0TD) en Extremadura.
        </p>
        <p class="mt-3 text-xs text-slate-500">
          Datos oficiales obtenidos directamente de <strong class="text-slate-400">Red Eléctrica de España (e·sios)</strong>.
        </p>
      </div>

      <!-- Columna 2: Enlaces de Utilidad -->
      <div>
        <p class="font-bold text-white text-sm uppercase tracking-wider mb-3">
          Navegación y Secciones
        </p>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="/#horas-hoy" class="hover:text-amber-400 transition-colors">Curva horaria de hoy (24 horas)</a>
          </li>
          <li>
            <a href="/#calculadora" class="hover:text-amber-400 transition-colors">Calculadora de electrodomésticos y clima</a>
          </li>
          <li>
            <a href="/#extremadura-energia" class="hover:text-amber-400 transition-colors">El papel de Extremadura en la energía nacional</a>
          </li>
          <li>
            <a href="/#faqs" class="hover:text-amber-400 transition-colors">Preguntas frecuentes sobre la tarifa PVPC</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Red de Proyectos -->
      <div>
        <p class="font-bold text-white text-sm uppercase tracking-wider mb-3">
          Red de Proyectos
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a
              href="https://combustible.antoniohorrillo.com/"
              class="text-slate-300 hover:text-sky-300 transition-colors inline-flex items-center gap-1.5"
              title="Gasolineras más baratas de Extremadura hoy"
            >
              <span class="text-sky-400">⛽</span>
              <span>Combustible Extremadura</span>
            </a>
            <span class="block text-[11px] text-slate-500 pl-5">Gasolina 95 y diésel diarios</span>
          </li>
          <li>
            <a
              href="https://embalses.antoniohorrillo.com/"
              class="text-slate-300 hover:text-cyan-300 transition-colors inline-flex items-center gap-1.5"
              title="Estado y capacidad de los embalses de Extremadura"
            >
              <span class="text-cyan-400">💧</span>
              <span>Embalses Extremadura</span>
            </a>
            <span class="block text-[11px] text-slate-500 pl-5">Capacidad y reservas hídricas</span>
          </li>
          <li>
            <a
              href="https://glucoluna.antoniohorrillo.com/"
              class="text-slate-300 hover:text-indigo-300 transition-colors inline-flex items-center gap-1.5"
              title="Calendario y control nocturno de glucosa"
            >
              <span class="text-indigo-400">🌙</span>
              <span>GlucoLuna</span>
            </a>
            <span class="block text-[11px] text-slate-500 pl-5">Control y diario de glucosa</span>
          </li>
          <li class="pt-1 border-t border-slate-800/80">
            <a
              href="https://antoniohorrillo.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-slate-400 hover:text-white transition-colors underline"
            >
              antoniohorrillo.com · Portafolio
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Transparencia y Privacidad -->
      <div>
        <p class="font-bold text-white text-sm uppercase tracking-wider mb-3">
          Privacidad y Transparencia
        </p>
        <p class="text-xs leading-relaxed text-slate-400 mb-3">
          Sin registros, sin muros de pago y sin publicidad intrusiva. Solo analítica anónima si das tu consentimiento expreso.
        </p>
        <div class="flex flex-wrap gap-2 text-xs">
          <a href={withBase("cookies/")} class="text-slate-300 hover:text-amber-400 underline">
            Política de cookies
          </a>
          <span>·</span>
          <button type="button" data-cookie-open-modal class="text-slate-300 hover:text-amber-400 underline cursor-pointer">
            Preferencias de cookies
          </button>
        </div>
      </div>
    </div>

    <!-- Barra inferior de copyright y créditos -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {year} Luz Extremadura · Creado por
        <a href={AUTHOR_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-300 hover:text-amber-400 underline">
          {AUTHOR_NAME}
        </a>
      </p>
      <p class="flex items-center gap-1.5">
        <RefreshCw size={13} class="text-slate-400" />
        <span>Actualización diaria a las 21:30 h y 06:00 h</span>
      </p>
    </div>
  </div>
</footer>
