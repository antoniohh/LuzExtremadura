---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  Zap,
  Clock,
  TrendingDown,
  TrendingUp,
  BarChart3,
  SunMedium,
  ShieldCheck,
  Calendar,
  HelpCircle,
  Flame,
  Snowflake,
  Tv,
  Car
} from "@lucide/astro";

import datosLuz from "../../public/datos/precios_luz_hoy.json";

const hoy = datosLuz.hoy;
const manana = datosLuz.manana;

// Determinar hora actual de España
const ahora = new Date();
const formatterHora = new Intl.DateTimeFormat("es-ES", {
  timeZone: "Europe/Madrid",
  hour: "numeric",
  hour12: false,
});
const horaActualInt = parseInt(formatterHora.format(ahora), 10);

// Buscar el registro de la hora actual
const horaActualData = hoy?.horas?.find((h: any) => h.hora === horaActualInt) || hoy?.horas?.[0];

function formatFecha(fechaISO: string) {
  if (!fechaISO) return "";
  const [y, m, d] = fechaISO.split("-");
  const meses = [
    "enero", "febrero", "marzo", "abril", "mayo", "junio",
    "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
  ];
  return `${parseInt(d, 10)} de ${meses[parseInt(m, 10) - 1]} de ${y}`;
}

const fechaHoyLegible = formatFecha(hoy?.fecha || "");
const fechaMananaLegible = formatFecha(manana?.fecha || "");

// Función auxiliar para formatear en €/kWh a 4 decimales
function fmtKwh(val: number | undefined) {
  if (val === undefined || val === null) return "0.0000";
  return Number(val).toFixed(4);
}
---

<BaseLayout
  title={`Precio de la Luz Hoy en Extremadura (${fechaHoyLegible}) | Hora a Hora PVPC`}
  description={`Consulta el precio de la luz hoy en Badajoz y Cáceres (${fechaHoyLegible}): precio actual ${fmtKwh(horaActualData?.precioKwh)} €/kWh, hora más barata (${hoy?.estadisticas?.precioMinimo?.rango} a ${fmtKwh(hoy?.estadisticas?.precioMinimo?.kwh)} €/kWh) y tramos valle, llano y punta.`}
>
  <!-- Hero Section con Termómetro en Vivo -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white pt-10 pb-16 sm:pb-24 border-b border-slate-700/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Encabezado Editorial -->
      <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs sm:text-sm font-semibold mb-4">
          <Zap size={15} class="fill-current" />
          <span>Tarifa regulada PVPC 2.0TD · Badajoz y Cáceres</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
          Precio de la luz hoy en <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300">Extremadura</span>
        </h1>
        <p class="mt-3 text-sm sm:text-base text-slate-300">
          Valores oficiales de Red Eléctrica para hoy <strong class="text-white font-semibold">{fechaHoyLegible}</strong>. Consulta cuándo poner la lavadora o el aire y ahorra en tu factura.
        </p>
      </div>

      <!-- Tarjeta Principal: Precio AHORA MISMO y Selector Hoy / Mañana -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch max-w-5xl mx-auto">
        
        <!-- Bloque Hora Actual -->
        <div class="lg:col-span-7 bg-slate-950/80 border border-slate-700 rounded-3xl p-6 sm:p-8 backdrop-blur-md shadow-2xl flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-8 -top-8 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-800 text-slate-300 border border-slate-700">
                <Clock size={13} class="text-amber-400" />
                <span>Ahora mismo ({horaActualData?.rango} h)</span>
              </span>

              {horaActualData?.nivel === 'barato' && (
                <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span>Barata</span>
                </span>
              )}
              {horaActualData?.nivel === 'medio' && (
                <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  <span>Media</span>
                </span>
              )}
              {horaActualData?.nivel === 'caro' && (
                <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                  <span>Cara</span>
                </span>
              )}
            </div>

            <!-- Gran Cifra de Precio en €/kWh -->
            <div class="flex items-baseline gap-2 my-2">
              <span class="text-5xl sm:text-6xl font-black tracking-tight text-white font-tabular">
                {fmtKwh(horaActualData?.precioKwh)}
              </span>
              <span class="text-xl sm:text-2xl font-bold text-amber-400">
                € / kWh
              </span>
            </div>
            <p class="text-xs text-slate-400 mt-1 font-mono">
              Precio mayorista de referencia: {horaActualData?.precioMwh} €/MWh
            </p>
          </div>

          <!-- Resumen de tramo regulado -->
          <div class="mt-6 pt-5 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-300">
            <div>
              <span class="text-slate-400 block">Tramo regulado:</span>
              <strong class="text-white uppercase font-bold text-sm tracking-wide">
                Tramo {horaActualData?.tramo}
              </strong>
            </div>
            <div class="text-right">
              <span class="text-slate-400 block">Media de hoy:</span>
              <strong class="text-amber-300 font-bold text-sm font-tabular">
                {fmtKwh(hoy?.estadisticas?.precioMedio?.kwh)} €/kWh
              </strong>
            </div>
          </div>
        </div>

        <!-- Bloque Mínimo y Máximo de Hoy -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <!-- Más barata -->
          <div class="flex-1 bg-emerald-950/50 border-2 border-emerald-500/60 rounded-2xl p-5 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3.5">
              <div class="w-12 h-12 rounded-xl bg-emerald-500 text-slate-950 flex items-center justify-center shrink-0 font-black shadow-md">
                <TrendingDown size={26} stroke-width={2.5} />
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 block">
                  Hora más barata hoy
                </span>
                <span class="text-sm font-extrabold text-white">
                  De {hoy?.estadisticas?.precioMinimo?.rango} h
                </span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-2xl sm:text-3xl font-black text-emerald-300 font-tabular">
                {fmtKwh(hoy?.estadisticas?.precioMinimo?.kwh)}
              </span>
              <span class="text-xs text-emerald-400/90 block font-semibold">€/kWh</span>
            </div>
          </div>

          <!-- Más cara -->
          <div class="flex-1 bg-rose-950/50 border-2 border-rose-500/60 rounded-2xl p-5 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3.5">
              <div class="w-12 h-12 rounded-xl bg-rose-500 text-white flex items-center justify-center shrink-0 font-black shadow-md">
                <TrendingUp size={26} stroke-width={2.5} />
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-rose-400 block">
                  Hora más cara hoy
                </span>
                <span class="text-sm font-extrabold text-white">
                  De {hoy?.estadisticas?.precioMaximo?.rango} h
                </span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-2xl sm:text-3xl font-black text-rose-300 font-tabular">
                {fmtKwh(hoy?.estadisticas?.precioMaximo?.kwh)}
              </span>
              <span class="text-xs text-rose-400/90 block font-semibold">€/kWh</span>
            </div>
          </div>

          <!-- Alerta de precios de mañana si existen -->
          {manana ? (
            <div class="bg-slate-900 border border-amber-500/40 rounded-2xl p-4 text-xs text-slate-300 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <Calendar size={16} class="text-amber-400 shrink-0" />
                <span>Precios de <strong>mañana ({fechaMananaLegible})</strong> ya disponibles</span>
              </div>
              <a href="#manana-seccion" class="font-bold text-amber-400 hover:underline">
                Ver mañana ↓
              </a>
            </div>
          ) : (
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-4 text-xs text-slate-400 flex items-center gap-2">
              <Clock size={16} class="text-slate-500 shrink-0" />
              <span>Precios de mañana disponibles a partir de las <strong>20:20 h</strong></span>
            </div>
          )}
        </div>

      </div>

    </div>
  </section>

  <!-- Curva Horaria de las 24 Horas de Hoy -->
  <section id="horas-hoy" class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div class="min-w-0">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 uppercase tracking-wider mb-1">
          <BarChart3 size={15} />
          <span>Curva horaria completa</span>
        </div>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 tracking-tight leading-snug">
          Precio de la luz hora a hora hoy ({fechaHoyLegible})
        </h2>
        <p class="text-slate-600 text-xs sm:text-sm mt-1">
          Semáforo energético para saber de un vistazo cuándo conviene encender aparatos.
        </p>
      </div>

      <!-- Leyenda visual de semáforo con texto limpio: Barata, Media, Cara -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-bold shrink-0">
        <span class="inline-flex items-center gap-1.5 text-emerald-900 bg-emerald-100 px-3 py-1.5 rounded-lg border-2 border-emerald-400 shadow-xs">
          <span class="w-3 h-3 rounded-full bg-emerald-500 border border-emerald-700"></span>
          <span>Barata</span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-amber-950 bg-amber-100 px-3 py-1.5 rounded-lg border-2 border-amber-400 shadow-xs">
          <span class="w-3 h-3 rounded-full bg-amber-500 border border-amber-700"></span>
          <span>Media</span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-rose-950 bg-rose-100 px-3 py-1.5 rounded-lg border-2 border-rose-400 shadow-xs">
          <span class="w-3 h-3 rounded-full bg-rose-500 border border-rose-700"></span>
          <span>Cara</span>
        </span>
      </div>
    </div>

    <!-- Tabla / Rejilla interactiva de las 24 Horas -->
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3.5">
      {hoy?.horas?.map((h: any) => {
        const esHoraActual = h.hora === horaActualInt;

        // Estilos claramente contrastados para cada nivel del semáforo
        let containerClass = "bg-amber-50/90 border-2 border-amber-300 text-amber-950 hover:border-amber-500";
        let tagClass = "bg-amber-200/90 text-amber-900 border border-amber-400";
        let priceClass = "text-amber-950";
        let dotColor = "bg-amber-500";
        let labelNivel = "Media";

        if (h.nivel === "barato") {
          containerClass = "bg-emerald-50 border-2 border-emerald-400 text-emerald-950 hover:border-emerald-600 shadow-xs";
          tagClass = "bg-emerald-200 text-emerald-950 border border-emerald-400 font-extrabold";
          priceClass = "text-emerald-900";
          dotColor = "bg-emerald-600";
          labelNivel = "Barata";
        } else if (h.nivel === "caro") {
          containerClass = "bg-rose-50 border-2 border-rose-400 text-rose-950 hover:border-rose-600 shadow-xs";
          tagClass = "bg-rose-200 text-rose-950 border border-rose-400 font-extrabold";
          priceClass = "text-rose-900";
          dotColor = "bg-rose-600";
          labelNivel = "Cara";
        }

        return (
          <div
            class={`relative rounded-2xl p-4 transition-all text-center flex flex-col justify-between ${containerClass} ${
              esHoraActual ? "ring-4 ring-slate-900 shadow-lg scale-[1.03] z-10" : ""
            }`}
          >
            {esHoraActual && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-slate-950 text-amber-300 text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wider shadow-md border border-amber-400">
                AHORA
              </span>
            )}

            <!-- Encabezado con franja horaria más remarcada y centrada -->
            <div>
              <div class="mb-2">
                <span class="font-mono text-sm font-black text-slate-900 tracking-tight block">
                  {h.rango} h
                </span>
              </div>

              <!-- Cifra en €/kWh más grande -->
              <div class="my-2">
                <span class={`text-2xl sm:text-[1.7rem] font-black font-tabular tracking-tight leading-none ${priceClass}`}>
                  {fmtKwh(h.precioKwh)}
                </span>
                <span class="text-[11px] text-slate-600 block font-bold mt-1">€/kWh</span>
              </div>
            </div>

            <!-- Pie de tarjeta con tramo regulado y chip a la derecha -->
            <div class="mt-3 pt-2.5 border-t border-slate-300/80 flex items-center justify-between text-[10px] font-bold text-slate-700 uppercase">
              <span class="flex items-center gap-1.5">
                <span class={`w-2 h-2 rounded-full ${dotColor}`}></span>
                <span>{h.tramo}</span>
              </span>
              <span class={`text-[9px] uppercase px-1.5 py-0.5 rounded-md ${tagClass}`}>
                {labelNivel}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Precios de Mañana si están disponibles -->
  {manana && (
    <section id="manana-seccion" class="py-12 bg-slate-100 border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
          <div class="min-w-0">
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 uppercase tracking-wider mb-1">
              <Calendar size={15} />
              <span>Avance de mañana</span>
            </div>
            <h2 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 tracking-tight leading-snug">
              Precios para mañana ({fechaMananaLegible})
            </h2>
            <p class="text-slate-600 text-xs sm:text-sm mt-1">
              Planifica tus consumos para mañana antes de salir de casa o irte a dormir.
            </p>
          </div>

          <div class="flex items-center gap-4 text-xs font-bold shrink-0">
            <span class="text-slate-800 bg-emerald-100 border border-emerald-300 px-3 py-1.5 rounded-lg">
              Mín: <strong class="text-emerald-900 font-tabular">{fmtKwh(manana.estadisticas.precioMinimo.kwh)} €/kWh</strong> ({manana.estadisticas.precioMinimo.rango} h)
            </span>
            <span class="text-slate-800 bg-rose-100 border border-rose-300 px-3 py-1.5 rounded-lg">
              Máx: <strong class="text-rose-900 font-tabular">{fmtKwh(manana.estadisticas.precioMaximo.kwh)} €/kWh</strong> ({manana.estadisticas.precioMaximo.rango} h)
            </span>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3.5">
          {manana.horas?.map((h: any) => {
            let containerClass = "bg-amber-50/90 border-2 border-amber-300 text-amber-950";
            let tagClass = "bg-amber-200/90 text-amber-900 border border-amber-400";
            let priceClass = "text-amber-950";
            let dotColor = "bg-amber-500";
            let labelNivel = "Media";

            if (h.nivel === "barato") {
              containerClass = "bg-emerald-50 border-2 border-emerald-400 text-emerald-950";
              tagClass = "bg-emerald-200 text-emerald-950 border border-emerald-400 font-extrabold";
              priceClass = "text-emerald-900";
              dotColor = "bg-emerald-600";
              labelNivel = "Barata";
            } else if (h.nivel === "caro") {
              containerClass = "bg-rose-50 border-2 border-rose-400 text-rose-950";
              tagClass = "bg-rose-200 text-rose-950 border border-rose-400 font-extrabold";
              priceClass = "text-rose-900";
              dotColor = "bg-rose-600";
              labelNivel = "Cara";
            }

            return (
              <div class={`rounded-2xl p-4 text-center flex flex-col justify-between ${containerClass}`}>
                <div class="mb-2">
                  <span class="font-mono text-sm font-black text-slate-900 tracking-tight block">{h.rango} h</span>
                </div>
                <div class="my-2">
                  <span class={`text-2xl sm:text-[1.7rem] font-black font-tabular tracking-tight leading-none ${priceClass}`}>
                    {fmtKwh(h.precioKwh)}
                  </span>
                  <span class="text-[11px] text-slate-600 block font-bold mt-1">€/kWh</span>
                </div>
                <div class="mt-3 pt-2.5 border-t border-slate-300/80 flex items-center justify-between text-[10px] font-bold text-slate-700 uppercase">
                  <span class="flex items-center gap-1.5">
                    <span class={`w-2 h-2 rounded-full ${dotColor}`}></span>
                    <span>{h.tramo}</span>
                  </span>
                  <span class={`text-[9px] uppercase px-1.5 py-0.5 rounded-md ${tagClass}`}>{labelNivel}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Calculadora Extremeña de Consumos Reales -->
  <section id="calculadora" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-600 uppercase tracking-wider mb-2">
        <Zap size={15} />
        <span>Calculadora adaptada a Extremadura</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        ¿Cuánto cuesta poner cada aparato en tu casa hoy?
      </h2>
      <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
        Calculamos el coste real por ciclo o por hora con los precios de hoy para los aparatos más habituales en Badajoz y Cáceres.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- 1. Aire Acondicionado (Verano Extremeño) -->
      <div class="bg-white border-2 border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center mb-4">
          <Snowflake size={24} />
        </div>
        <h3 class="text-lg font-bold text-slate-900">Aire Acondicionado</h3>
        <p class="text-xs text-slate-500 mt-1 mb-4">Split Inverter estándar (~1,2 kW)</p>
        
        <div class="space-y-3 pt-4 border-t border-slate-100 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-slate-600">1 hora en hora barata:</span>
            <strong class="text-emerald-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMinimo?.kwh || 0.10) * 1.2)).toFixed(2)} €
            </strong>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-slate-600">1 hora en hora cara:</span>
            <strong class="text-rose-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMaximo?.kwh || 0.30) * 1.2)).toFixed(2)} €
            </strong>
          </div>
          <p class="text-[11px] text-slate-500 italic mt-2">
            *Diferencia notable según tramo horario.
          </p>
        </div>
      </div>

      <!-- 2. Termo Eléctrico (Pueblos sin gas natural) -->
      <div class="bg-white border-2 border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
          <Flame size={24} />
        </div>
        <h3 class="text-lg font-bold text-slate-900">Termo Eléctrico (80L)</h3>
        <p class="text-xs text-slate-500 mt-1 mb-4">Calentamiento diario (~2,5 kWh)</p>
        
        <div class="space-y-3 pt-4 border-t border-slate-100 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Programado en hora barata:</span>
            <strong class="text-emerald-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMinimo?.kwh || 0.10) * 2.5)).toFixed(2)} €
            </strong>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Encendido en hora punta:</span>
            <strong class="text-rose-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMaximo?.kwh || 0.30) * 2.5)).toFixed(2)} €
            </strong>
          </div>
          <p class="text-[11px] text-slate-500 italic mt-2">
            Ahorro de más de 12 €/mes usando un simple reloj temporizador.
          </p>
        </div>
      </div>

      <!-- 3. Lavadora (Ciclo Completo) -->
      <div class="bg-white border-2 border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center mb-4">
          <Tv size={24} />
        </div>
        <h3 class="text-lg font-bold text-slate-900">Lavadora (60 °C / Eco)</h3>
        <p class="text-xs text-slate-500 mt-1 mb-4">Ciclo de lavado estándar (~1,4 kWh)</p>
        
        <div class="space-y-3 pt-4 border-t border-slate-100 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Ponerla en hora barata:</span>
            <strong class="text-emerald-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMinimo?.kwh || 0.10) * 1.4)).toFixed(2)} €
            </strong>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Ponerla en hora punta:</span>
            <strong class="text-rose-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMaximo?.kwh || 0.30) * 1.4)).toFixed(2)} €
            </strong>
          </div>
          <p class="text-[11px] text-slate-500 italic mt-2">
            Mover 4 lavadoras a la semana a tramo valle supone un ahorro perceptible.
          </p>
        </div>
      </div>

      <!-- 4. Vehículo Eléctrico / Híbrido Enchufable -->
      <div class="bg-white border-2 border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-4">
          <Car size={24} />
        </div>
        <h3 class="text-lg font-bold text-slate-900">Coche Eléctrico (100 km)</h3>
        <p class="text-xs text-slate-500 mt-1 mb-4">Consumo de 15 kWh para 100 km</p>
        
        <div class="space-y-3 pt-4 border-t border-slate-100 text-xs">
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Carga nocturna (hora valle):</span>
            <strong class="text-emerald-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMinimo?.kwh || 0.10) * 15)).toFixed(2)} €
            </strong>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-slate-600">Carga diurna descontrolada:</span>
            <strong class="text-rose-700 font-bold font-tabular text-sm">
              {(((hoy?.estadisticas?.precioMaximo?.kwh || 0.30) * 15)).toFixed(2)} €
            </strong>
          </div>
          <p class="text-[11px] text-slate-500 italic mt-2">
            Frente a los ~9 € de diésel o gasolina por cada 100 km.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección Especial: El Papel Energético de Extremadura -->
  <section id="extremadura-energia" class="py-16 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-500/30">
            <SunMedium size={14} />
            <span>Extremadura, potencia limpia</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white leading-tight">
            ¿Sabías que Extremadura genera más de 4 veces la electricidad que consume?
          </h2>
          <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
            Nuestra comunidad autónoma es uno de los principales motores energéticos de España. Con los embalses hidroeléctricos del Tajo y el Guadiana (Alcántara, Cedillo, Valdecañas), la central nuclear de Almaraz y gigantes fotovoltaicos como Núñez de Balboa (Usagre) o Talayuela, Extremadura exporta la inmensa mayoría de su energía limpia a las grandes urbes peninsulares.
          </p>
          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <span class="text-3xl font-black text-amber-400 block">+400 %</span>
              <span class="text-xs text-slate-400">Balance de generación frente a la demanda regional</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <span class="text-3xl font-black text-emerald-400 block">Líder Solar</span>
              <span class="text-xs text-slate-400">Comunidad con mayor potencia fotovoltaica instalada</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 bg-slate-950 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <ShieldCheck size={20} class="text-emerald-400" />
            <span>¿Por qué pagamos el mismo precio si producimos más?</span>
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed space-y-3">
            El sistema eléctrico español opera mediante un <strong>mercado marginalista único peninsular</strong> (OMIE / REE). Toda la electricidad generada entra en una red común y el precio del kWh se fija para todos los consumidores de la Península por igual mediante casación horaria.
          </p>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mt-3">
            Por eso, la mejor forma de aprovechar la abundancia solar en el campo extremeño es conocer los tramos valle del mediodía y programar tus electrodomésticos en esas ventanas de bajo coste.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dudas Frecuentes (FAQS) -->
  <section id="faqs" class="py-16 sm:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
        <HelpCircle size={15} />
        <span>Preguntas Frecuentes</span>
      </div>
      <h2 class="text-3xl font-black text-slate-900 tracking-tight">
        Todo lo que necesitas saber sobre el precio de la luz
      </h2>
    </div>

    <div class="space-y-4">
      <details class="group bg-white border border-slate-200 rounded-2xl p-5 open:ring-2 open:ring-amber-500/20 transition-all">
        <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
          <span>¿A qué hora se publican los precios de mañana?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
          Red Eléctrica de España (REE) publica los precios definitivos para el día siguiente todos los días entre las <strong>20:15 y las 20:30 horas</strong>. Nuestra plataforma actualiza los datos automáticamente en cuanto se emiten.
        </p>
      </details>

      <details class="group bg-white border border-slate-200 rounded-2xl p-5 open:ring-2 open:ring-amber-500/20 transition-all">
        <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
          <span>¿Qué diferencia hay entre la tarifa PVPC y el mercado libre?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">
          El <strong>PVPC (Precio Voluntario para el Pequeño Consumidor)</strong> es la tarifa regulada por el Gobierno de España, donde el precio del kWh cambia cada hora según el coste real de la energía en el mercado mayorista. En el mercado libre, pactas un precio fijo o indexado con una comercializadora privada mediante contrato anual.
        </p>
      </details>

      <details class="group bg-white border border-slate-200 rounded-2xl p-5 open:ring-2 open:ring-amber-500/20 transition-all">
        <summary class="font-bold text-slate-900 cursor-pointer list-none flex items-center justify-between text-sm sm:text-base">
          <span>¿Cuáles son los tramos horarios oficiales (Valle, Llano y Punta)?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed space-y-1">
          <p><strong>Valle (más barato):</strong> De 00:00 a 08:00 h todos los días de diario, y las 24 horas durante fines de semana y festivos nacionales.</p>
          <p><strong>Llano (medio):</strong> De 08:00 a 10:00 h, de 14:00 a 18:00 h y de 22:00 a 24:00 h.</p>
          <p><strong>Punta (más caro):</strong> De 10:00 a 14:00 h y de 18:00 a 22:00 h de lunes a viernes.</p>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
