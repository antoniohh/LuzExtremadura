---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  Mail,
  ArrowLeft,
  ExternalLink,
  MessageSquare,
  ShieldAlert,
  Globe,
  Code2,
} from "@lucide/astro";
import { withBase, SITE_DOMAIN, AUTHOR_NAME, AUTHOR_URL, AUTHOR_EMAIL } from "../lib/site";
---

<BaseLayout
  title="Contacto y Soporte | Luz Extremadura"
  description="Canales oficiales de contacto, soporte técnico, sugerencias y ejercicio de derechos legales del portal Luz Extremadura (luzextremadura.es)."
  canonicalPath="contacto/"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <a
        href={withBase()}
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-600 hover:text-amber-600 transition-colors"
      >
        <ArrowLeft size={16} />
        <span>Volver a la portada</span>
      </a>

      <!-- Navegación rápida entre páginas legales y contacto -->
      <nav aria-label="Documentación legal y contacto" class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <a
          href={withBase("aviso-legal/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Aviso legal
        </a>
        <a
          href={withBase("privacidad/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Política de privacidad
        </a>
        <a
          href={withBase("cookies/")}
          class="px-3 py-1.5 rounded-lg bg-slate-200/80 text-slate-700 hover:bg-slate-300 transition-colors"
        >
          Política de cookies
        </a>
        <span class="px-3 py-1.5 rounded-lg bg-slate-900 text-amber-400">
          Contacto
        </span>
      </nav>
    </div>

    <header class="mb-10 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-2.5 text-amber-600 font-bold text-sm uppercase tracking-wider mb-2">
        <Mail size={20} />
        <span>Atención al Usuario y Comunicación Directa</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Contacto y Soporte
      </h1>
      <p class="mt-3 text-base sm:text-lg text-slate-600">
        Vías directas de comunicación con el titular de <strong>Luz Extremadura ({SITE_DOMAIN})</strong> para consultas sobre la herramienta, sugerencias de mejora, incidencias técnicas o cuestiones legales.
      </p>
    </header>

    <div class="space-y-8 text-slate-700 text-sm sm:text-base leading-relaxed">
      <!-- Tarjetas de Canales Directos -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Canal 1: Contacto con el Autor / Titular -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center mb-4">
              <Globe size={22} />
            </div>
            <h2 class="text-lg font-extrabold text-slate-900 mb-2">
              Contacto con el titular ({AUTHOR_NAME})
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              Para consultas generales, propuestas de colaboración, prensa o comunicaciones legales relacionadas con el dominio <strong>{SITE_DOMAIN}</strong> y el ejercicio de derechos RGPD / LSSI-CE.
            </p>
            <p class="mt-3 text-sm text-slate-700">
              <strong>Correo electrónico directo:</strong>{" "}
              <a
                href={`mailto:${AUTHOR_EMAIL}`}
                class="font-bold text-amber-700 hover:underline"
              >
                {AUTHOR_EMAIL}
              </a>
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2.5">
            <a
              href={`mailto:${AUTHOR_EMAIL}`}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 font-bold text-xs sm:text-sm transition-colors"
            >
              <Mail size={15} />
              <span>Escribir correo</span>
            </a>
            <a
              href={AUTHOR_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm transition-colors"
            >
              <span>Web del autor</span>
              <ExternalLink size={15} />
            </a>
          </div>
        </div>

        <!-- Canal 2: Soporte Técnico y Sugerencias -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center mb-4">
              <Code2 size={22} />
            </div>
            <h2 class="text-lg font-extrabold text-slate-900 mb-2">
              Incidencias técnicas y mejoras
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">
              ¿Has detectado algún error visual en tu móvil, tienes una idea para la calculadora de ahorro o quieres revisar el código fuente? Puedes abrir un ticket público en nuestro repositorio oficial.
            </p>
          </div>
          <div class="mt-5 pt-4 border-t border-slate-100">
            <a
              href="https://github.com/antoniohh/LuzExtremadura/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs sm:text-sm transition-colors"
            >
              <span>Abrir incidencia en GitHub</span>
              <ExternalLink size={15} />
            </a>
          </div>
        </div>
      </section>

      <!-- Aviso Importante: No somos una compañía eléctrica -->
      <section class="bg-amber-50/80 border border-amber-200 rounded-2xl p-6 sm:p-8">
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 mt-0.5">
            <ShieldAlert size={22} />
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-extrabold text-slate-900 mb-2">
              Importante: ¿Tienes una consulta sobre tu factura, contrato o avería eléctrica?
            </h2>
            <p class="text-sm sm:text-base text-slate-700">
              <strong>Luz Extremadura ({SITE_DOMAIN}) es un portal informativo independiente</strong> y no una compañía eléctrica ni comercializadora. No emitimos facturas, no gestionamos contratos de luz ni tenemos acceso a tus datos de suministro o contador.
            </p>
            <p class="mt-3 text-sm text-slate-700">
              Si necesitas gestionar tu contrato de tarifa regulada PVPC, reclamar una factura o comunicar una avería de suministro en las provincias de Badajoz o Cáceres, debes acudir directamente a tu <strong>Comercializadora de Referencia</strong> o a la distribuidora de tu zona (indicadas en el encabezado de tu factura de la luz), o bien a los organismos oficiales:
            </p>
            <ul class="list-disc pl-5 mt-3 space-y-1.5 text-xs sm:text-sm text-slate-700">
              <li>
                <strong>Comisión Nacional de los Mercados y la Competencia (CNMC):</strong> Información sobre comercializadoras de referencia PVPC y comparador oficial de ofertas de energía (<a href="https://comparador.cnmc.gob.es/" target="_blank" rel="noopener noreferrer" class="font-semibold text-amber-800 underline">comparador.cnmc.gob.es</a>).
              </li>
              <li>
                <strong>Instituto de Consumo de Extremadura (INCOEX):</strong> Atención y reclamaciones de personas consumidoras en la Junta de Extremadura (<a href="https://saludextremadura.ses.es/incoex/" target="_blank" rel="noopener noreferrer" class="font-semibold text-amber-800 underline">saludextremadura.ses.es/incoex</a>).
              </li>
              <li>
                <strong>Red Eléctrica de España (REE / e·sios):</strong> Fuente oficial de los precios mayoristas y minoristas PVPC (<a href="https://www.esios.ree.es/es/pvpc" target="_blank" rel="noopener noreferrer" class="font-semibold text-amber-800 underline">esios.ree.es/es/pvpc</a>).
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Privacidad en las comunicaciones -->
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs">
        <div class="flex items-center gap-2.5 mb-3">
          <MessageSquare size={20} class="text-slate-700" />
          <h2 class="text-lg sm:text-xl font-bold text-slate-900">
            Privacidad en tus comunicaciones
          </h2>
        </div>
        <p class="text-sm sm:text-base text-slate-600">
          Para garantizar tu máxima privacidad y evitar almacenar datos personales innecesarios en servidores intermedios, <strong>{SITE_DOMAIN}</strong> no incluye formularios web que guarden tus datos en bases de datos propias. Cualquier comunicación realizada con el titular se atenderá exclusivamente con la finalidad de responder a tu consulta, sin incorporar tu dirección ni tus datos a listas comerciales ni cederlos a terceros, conforme a nuestra{" "}
          <a href={withBase("privacidad/")} class="font-bold text-amber-700 hover:underline">
            Política de Privacidad
          </a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
