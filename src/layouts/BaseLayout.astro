---
import "../styles/global.css";
import Header from "../components/Header.astro";
import NetworkBar from "../components/NetworkBar.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import InstallPrompt from "../components/InstallPrompt.astro";
import {
  SITE,
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  AUTHOR_NAME,
  AUTHOR_URL,
  absoluteUrl,
  withBase,
} from "../lib/site";
import { FAQS_SEO } from "../data/faqs";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
}

const {
  title = "Precio de la Luz Hoy en Extremadura (Badajoz y Cáceres) | Horas y PVPC 2.0TD",
  description = SITE_DESCRIPTION,
  canonicalPath = "",
  ogType = "website",
} = Astro.props;

const canonical = absoluteUrl(canonicalPath);
const ogImage = absoluteUrl("assets/og-image.png");
const logoUrl = absoluteUrl("assets/logo.svg");

// Schema.org Structured Data Avanzado (Grafo Completo: WebSite, WebPage, Dataset y FAQPage)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: SITE,
      name: SITE_NAME,
      alternateName: "Precio Luz Hoy Extremadura",
      description: SITE_DESCRIPTION,
      inLanguage: "es-ES",
      publisher: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: AUTHOR_URL,
        image: logoUrl,
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description: description,
      datePublished: "2026-11-02T20:00:00+01:00",
      dateModified: new Date().toISOString(),
      isPartOf: { "@id": `${SITE}/#website` },
      inLanguage: "es-ES",
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImage,
        width: 1200,
        height: 630,
      },
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Precio de la Luz Hoy en Extremadura",
            item: SITE,
          },
        ],
      },
    },
    {
      "@type": "Dataset",
      "@id": `${SITE}/#dataset`,
      name: "Precios Horarios Oficiales del PVPC (Tarifa Regulada 2.0TD) en España y Extremadura",
      description: "Registro de precios horarios de la energía eléctrica (PVPC) publicados por Red Eléctrica de España para el mercado peninsular.",
      url: canonical,
      sameAs: "https://api.esios.ree.es/archives/70/download_json?locale=es",
      keywords: SITE_KEYWORDS,
      creator: {
        "@type": "Person",
        name: AUTHOR_NAME,
        url: AUTHOR_URL,
      },
      isAccessibleForFree: true,
      license: "https://opensource.org/licenses/MIT",
      spatialCoverage: [
        {
          "@type": "Place",
          name: "Extremadura, España",
          geo: {
            "@type": "GeoCoordinates",
            latitude: "39.1667",
            longitude: "-6.1667",
          },
        },
        {
          "@type": "Place",
          name: "Provincia de Badajoz, España",
        },
        {
          "@type": "Place",
          name: "Provincia de Cáceres, España",
        },
      ],
      distribution: [
        {
          "@type": "DataDownload",
          encodingFormat: "application/json",
          contentUrl: absoluteUrl("datos/precios_luz_hoy.json"),
          name: "Precios horarios de hoy y mañana en Extremadura (JSON)",
        },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${SITE}/#faq`,
      mainEntity: FAQS_SEO.map((faq) => ({
        "@type": "Question",
        name: faq.pregunta,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.respuesta,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <!-- Google Consent Mode v2 & Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      var savedConsent = null;
      try {
        savedConsent = localStorage.getItem("luz_extremadura_cookie_consent");
      } catch (e) {}

      // 1. Regla específica primero: Territorios bajo RGPD (EEE + Reino Unido + Suiza).
      // Bloqueo estricto por defecto hasta que el usuario interactúe con el banner.
      gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
        region: [
          "AT", "BE", "BG", "HR", "CY", "CZ", "DK", "EE", "FI", "FR",
          "DE", "GR", "HU", "IS", "IE", "IT", "LV", "LI", "LT", "LU",
          "MT", "NL", "NO", "PL", "PT", "RO", "SK", "SI", "ES", "SE",
          "GB", "CH",
        ],
      });

      // 2. Regla global (resto del mundo fuera del EEE): concedido por defecto.
      gtag("consent", "default", {
        analytics_storage: "granted",
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
      });

      // 3. Si el usuario ya tomó una decisión previa, se envía 'update' inmediatamente
      // en <head> antes de gtag('config') para que Google registre la transición
      // default -> update ('r' si aceptó, 'q' si rechazó) en el parámetro gcd.
      if (savedConsent === "granted" || savedConsent === "denied") {
        gtag("consent", "update", {
          analytics_storage: savedConsent,
          ad_storage: savedConsent,
          ad_user_data: savedConsent,
          ad_personalization: savedConsent,
        });
      }

      gtag("js", new Date());
      gtag("config", "G-HEKMQY6G5E", {
        anonymize_ip: true,
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HEKMQY6G5E"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE_KEYWORDS.join(", ")} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content={AUTHOR_NAME} />

    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={withBase("site.webmanifest")} />
    <link rel="sitemap" type="application/xml" href={withBase("sitemap.xml")} />
    <link rel="icon" type="image/svg+xml" href={withBase("assets/favicon.svg")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("assets/apple-touch-icon.png")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Precio de la Luz Hoy en Extremadura (Badajoz y Cáceres)" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Precio de la Luz Hoy en Extremadura (Badajoz y Cáceres)" />

    <!-- Geo Tags Extremadura -->
    <meta name="geo.region" content="ES-EX" />
    <meta name="geo.placename" content="Extremadura, Badajoz, Cáceres, Mérida" />
    <meta name="geo.position" content="39.1667;-6.1667" />
    <meta name="ICBM" content="39.1667, -6.1667" />

    <!-- PWA Service Worker -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans overflow-x-hidden max-w-full">
    <NetworkBar currentProject="luz" />
    <Header />
    <main class="flex-1 w-full max-w-full overflow-x-hidden">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <InstallPrompt />
  </body>
</html>
